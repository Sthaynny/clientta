rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function subscriptionUnchanged() {
      return request.resource.data.get('subscription', null)
        == resource.data.get('subscription', null);
    }

    function billingEntitlementUnchanged() {
      return request.resource.data.get('billingEntitlement', null)
        == resource.data.get('billingEntitlement', null);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && !('subscription' in request.resource.data)
        && !('billingEntitlement' in request.resource.data);
      allow update: if isOwner(userId)
        && subscriptionUnchanged()
        && billingEntitlementUnchanged();

      match /appointments/{appointmentId} {
        allow read, write: if isOwner(userId);
      }

      match /encounterNotes/{noteId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /billing_events/{eventId} {
      allow read, write: if false;
    }

    match /billing_free_access/{email} {
      allow read, write: if false;
    }

    match /billing_discounts/{email} {
      allow read, write: if false;
    }
  }
}
